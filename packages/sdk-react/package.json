{
  "name": "@notikit/react",
  "version": "0.1.0",
  "description": "Notikit React SDK — hooks over the web SDK (Next.js compatible)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notikit/notikit.git",
    "directory": "packages/sdk-react"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@notikit/core": "workspace:*",
    "@notikit/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "happy-dom": "^20.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
