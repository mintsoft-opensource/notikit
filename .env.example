# ── Notikit 환경 변수 ─────────────────────────────────────────
# 앱
NODE_ENV=production
APP_URL=http://localhost:3000
# 부팅 시 필수 검증(12-factor). 미설정이면 앱이 시작을 거부.
NOTIKIT_ENCRYPTION_KEY=change-me-32-byte-base64-secret==

# DB / 큐 (self-host 기본; 프로덕션은 관리형으로 교체)
DATABASE_URL=postgres://notikit:notikit@localhost:5432/notikit
REDIS_URL=redis://localhost:6379

# 로그/이벤트 저장소 (기본 = OLTP 내 파티션; 스케일 시 CLICKHOUSE_URL 지정)
# CLICKHOUSE_URL=

# 실시간 채널 (webview/electron/web 상시연결 — 선택)
# CENTRIFUGO_URL=

# 워커 튜닝
WORKER_CONCURRENCY=8
PUSH_BATCH_SIZE=500

# 리텐션 (로그 자동 purge, 일)
LOG_RETENTION_DAYS=30

# 카카오 알림톡 폴백 (선택 — 국내)
# KAKAO_ALIMTALK_API_KEY=
# KAKAO_ALIMTALK_SENDER_KEY=

# 관리자 세션 / Web Admin API 토큰
SESSION_SECRET=change-me-session-secret
ADMIN_TOKEN=change-me-admin-token
