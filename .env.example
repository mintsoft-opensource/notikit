# ── Notikit 환경 변수 ─────────────────────────────────────────
# 아래 "실제 사용" 값만 코드가 읽는다. "계획/미사용"은 로드맵용 플레이스홀더.

# ── 실제 사용 (필수) ──────────────────────────────────────────
# 시크릿 암호화 키(AES-256-GCM, 32자 이상 권장). api-secret/Firebase/카카오 설정 암복호에 사용.
NOTIKIT_ENCRYPTION_KEY=change-me-32-byte-secret-minimum
# Web Admin API 토큰(x-admin-token). 관리 엔드포인트·worker 인증에 필수.
ADMIN_TOKEN=change-me-admin-token
# Postgres 연결 문자열. (Docker Compose 는 compose 파일에서 web/migrate 에 주입한다 —
# compose 가 POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB 로 조립하므로 여기 값은 호스트에서
# 직접 돌릴 때(수동 next start, e2e) 쓰인다)
DATABASE_URL=postgres://notikit:notikit@localhost:5432/notikit
# compose 의 postgres 초기화 비밀번호. **기본값이 없다** — 두 compose 파일 모두 미설정이면
# 기동을 거부한다. compose 파일에 비밀번호를 박아 두면 아무도 바꾸지 않기 때문이다.
POSTGRES_PASSWORD=change-me-postgres-password
# POSTGRES_USER=notikit
# POSTGRES_DB=notikit

# ── 인증/세션 (로그인) ────────────────────────────────────────
# 세션 쿠키 서명 키. 미설정 시 NOTIKIT_ENCRYPTION_KEY 로 대체. (별도 권장)
# SESSION_SECRET=change-me-session-secret
# ⚠️ 프로덕션 보안: 최초 관리자 선점(anyone-claims-first) 방지 — 설정 시 최초 등록에
#    x-bootstrap-token 헤더 필요. 공개 배포 전 반드시 설정 권장.
# BOOTSTRAP_TOKEN=change-me-bootstrap-token
# 브라우저 대면 오리진(CSRF 정확 대조). 리버스 프록시(TLS 종료) 뒤라면 https 오리진 지정.
# APP_ORIGIN=https://push.example.com
# http 로컬/개발에서 Secure 쿠키 비활성 (기본: NODE_ENV=production 이면 Secure).
# COOKIE_INSECURE=false
# 비밀번호 해싱(scrypt) 동시성/큐 상한 (자원 고갈 방어). 기본 2 / 50.
# SCRYPT_CONCURRENCY=2
# SCRYPT_MAX_QUEUE=50

# ── 실제 사용 (선택, 기본값 있음) ─────────────────────────────
# DB 커넥션 풀 (postgres-js). 미지정 시 코드 기본값 사용.
# POOL_MAX=10
# POOL_IDLE_TIMEOUT=20
# POOL_CONNECT_TIMEOUT=10
# 발송 한도를 인스턴스끼리 공유한다(고정 창). 비우면 인스턴스마다 따로 세므로
# web 을 2대 이상 띄우면 실제 허용치가 대수만큼 늘어난다. 한 대면 없어도 된다.
# Redis 가 죽어도 요청은 막히지 않는다 — 메모리 판정으로 내려앉는다.
# REDIS_URL=redis://localhost:6379
# worker 폴링 대상/주기 (worker 프로세스 전용)
# WORKER_BASE_URL=http://localhost:3000
# WORKER_INTERVAL_MS=10000
# 한 tick 에서 동시에 처리하는 프로젝트 수. 순차면 대형 발송 하나가 뒤를 전부 붙잡는다.
# WORKER_CONCURRENCY=4
# 요청 1건의 마감 시각. 서버가 응답 없이 매달리면 tick 전체가 선다.
# WORKER_REQUEST_TIMEOUT_MS=120000
# 실패한 웹훅 배달 재시도 스윕 주기(최소 5000). tick 마다 부르면 빈 질의만 반복된다.
# WORKER_WEBHOOK_SWEEP_MS=60000
# SIGTERM 뒤 진행 중 tick 을 기다리는 상한. compose 의 stop_grace_period 보다 작아야 한다.
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
# 죽은 토큰 야간 스윕 (FCM dry-run — 배달되지 않으므로 유저에게 알림이 뜨지 않는다).
# 새벽에 도는 이유는 방해 회피가 아니라 부하와 FCM 할당량 때문이다.
# 시각은 UTC 기준이며, 프로젝트별로 0-59분에 분산되어 정각 몰림을 막는다.
# TOKEN_CHECK_ENABLED=true
# TOKEN_CHECK_HOUR_UTC=0
# 이 시간 안에 이미 검사된 프로젝트는 건너뛴다(다중 워커 중복 방지)
# TOKEN_CHECK_MIN_INTERVAL_HOURS=20
# partial 이어받기 상한 — 한 프로젝트가 tick 을 무한히 붙잡지 않게. 남으면 다음 창에서 이어진다.
# TOKEN_CHECK_MAX_ROUNDS=20
# 마이그레이션 SQL 디렉터리 override (기본: apps/web/drizzle)
# DRIZZLE_DIR=

# 카카오 알림톡: env 가 아니라 **프로젝트별로** 웹에서 업로드(POST /api/admin/projects/{id}/kakao).

# ── 계획/미사용 (현재 코드가 읽지 않음, 로드맵) ───────────────
# APP_URL=http://localhost:3000        # 절대 URL 생성 예정
# PUSH_BATCH_SIZE=500                  # 배치 크기 튜닝(현재 코드 상수)
LOG_RETENTION_DAYS=30                  # push_logs 보존 일수. **미설정이면 purge 하지 않는다**
                                       # = 로그가 무한히 자라 디스크를 채운다(코어 테이블과 같은 DB).
                                       # 온프렘 인수인계 전 반드시 합의할 것. 워커가 야간에 배치 삭제.
# CLICKHOUSE_URL=                      # 이벤트 OLAP 스토어 도입 시
# CENTRIFUGO_URL=                      # 실시간 채널 도입 시

# ── 자동 업데이트 (고객사 인스턴스) ───────────────────────────────────────────
# 콘솔에서 업데이트 버튼을 켠다. 끄면 설치 경로가 404 가 된다.
# 호스팅(멀티테넌트) 배포에서는 켜지 않는다 — 거기선 CI 가 배포한다.
NOTIKIT_SELF_UPDATE=false

# 배포처. 공개 릴리스가 아니라 인증이 붙은 업데이트 서버에 묻는다.
NOTIKIT_UPDATE_SERVER=https://updates.example.com
# 이 설치의 신원이자 구독 증명. 만료되면 업데이트만 막히고 서비스는 계속 돈다.
NOTIKIT_LICENSE_KEY=
# stable | beta — 고객사별로 다르게 줄 수 있다
NOTIKIT_UPDATE_CHANNEL=stable

# 프라이빗 레지스트리. 업데이터만 쓴다(web 컨테이너에는 필요 없다).
REGISTRY_SERVER=registry.example.com
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 프로덕션 compose 에서 쓰는 값들
# NOTIKIT_IMAGE 는 .notikit-image.env 에 있고 업데이터가 갱신한다 — 여기 두지 않는다.
NOTIKIT_UPDATER_IMAGE=registry.example.com/notikit-updater:0.1.0
NOTIKIT_PORT=3000
# 콘솔을 어느 주소에 붙일지. 기본은 루프백 — 리버스 프록시(TLS 종료) 뒤가 전제다.
# 프록시 없이 직접 노출하려면 0.0.0.0 으로.
NOTIKIT_BIND=127.0.0.1

# ── 라이선스 (클로즈드 배포) ──────────────────────────────────────────────────
# 고객사에 발급한 라이선스. 이것이 곧 신원이자 구독 증명이다.
NOTIKIT_LICENSE_KEY=
# 검증용 공개키. **오프라인에서** 검증되므로 폐쇄망에서도 동작한다.
# 비밀키는 절대 여기 넣지 않는다 — 발급 장비에만 둔다.
NOTIKIT_LICENSE_PUBLIC_KEY=

# 폐쇄망 반입 번들을 두는 곳. 운영자가 파일을 두면 콘솔 목록에 나타난다.
BUNDLE_DIR=/bundles
