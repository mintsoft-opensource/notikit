{
  "name": "notikit",
  "version": "0.1.0",
  "private": true,
  "description": "Notikit — open-source, self-hostable, user-centric push notification toolkit",
  "license": "Apache-2.0",
  "packageManager": "pnpm@8.12.1",
  "scripts": {
    "dev": "pnpm --filter @notikit/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
